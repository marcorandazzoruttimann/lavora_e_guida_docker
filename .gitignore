# Virtual environments
.venv/
venv/
env/

# Local secrets / env
# `.env` è il file con le chiavi vere (Gemini, Tavily, Gmail): non va mai in git.
.env
# Varianti locali (`.env.docker`, `.env.local`, `.env.wsl`, …) contengono
# lo stesso tipo di secret o path Desktop: le ignoriamo tutte.
.env.*
# `.env.example` è il template committabile (chiavi vuote / placeholder).
# Senza questa eccezione, `.env.*` lo escluderebbe dal repo.
!.env.example

# Override Compose locale: path Desktop, porte, bind mount specifici della
# macchina. Il file base `docker-compose.yml` resta tracciato.
docker-compose.override.yml

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
*.egg

# Test / type / lint caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/
.nox/

# IDE / OS
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# Logs / runtime
*.log
logs/

# Stato locale generato (cartella tracciata via .gitkeep): RAG, telemetria,
# token Gmail, SQLite, Chroma. Ignoriamo *tutto* il contenuto così un file
# nuovo (es. un altro DB) non finisce in git per sbaglio.
runtime/*
# Eccezione: `.gitkeep` tiene la cartella nel repo anche se è vuota.
!runtime/.gitkeep
# Residuo del vecchio nome cartella (pre-rename ollama_lab → runtime)
ollama_lab/files.db
ollama_lab/telemetry.db
ollama_lab/chroma/
ollama_lab/gmail_token.json

# Gmail OAuth: refresh token (Google lo riscrive) e JSON credenziali scaricato dalla Console
**/gmail_token.json
**/client_secret*.json

# Riferimento CrewAI/AutoGen: non entra in src/ né nel prodotto vocale
template_professional/

# Note personali / backlog locale, non del repo
TO_DO_LIST.txt
