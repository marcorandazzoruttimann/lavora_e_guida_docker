<?xml version="1.0" encoding="utf-8"?>
<!--
  Manifest Win32 unpackaged. Non sostituisce i prerequisiti Windows
  (microfono, Riconoscimento vocale online, pacchetto lingua it-IT):
  quelli stanno in Impostazioni, non qui.
-->
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <assemblyIdentity version="1.0.0.0" name="stt_helper.app"/>
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v2">
    <security>
      <requestedPrivileges xmlns="urn:schemas-microsoft-com:asm.v3">
        <!-- asInvoker: HttpListener su 127.0.0.1 non richiede admin né netsh urlacl. -->
        <requestedExecutionLevel level="asInvoker" uiAccess="false" />
      </requestedPrivileges>
    </security>
  </trustInfo>
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 / 11: stesso GUID, così il runtime non emula Win8. -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}" />
    </application>
  </compatibility>
</assembly>
