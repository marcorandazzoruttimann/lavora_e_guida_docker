# Audio I/O: mock (CLI keyboard/print) | http (bridge verso l'host Windows).
# Host WinRT + edge-tts: docs/audio_host.md — si avvia con python.exe su
# Windows (windows_audio/server.py), non da WSL. WAKE_* / TTS_VOICE / bind
# della 8765 stanno nel processo host, non in questo .env.
AUDIO_DRIVER=mock

# Local Ollama model (one at a time; hardware-friendly defaults)
# Default: qwen2.5:3b — se WSL ha poca RAM, preferire gemma2:2b
# (vedi docs/ollama.md).
OLLAMA_MODEL=qwen2.5:3b
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# Se Ollama gira sull'host Windows, es.:
# OLLAMA_BASE_URL=http://$(awk '/^nameserver/{print $2;exit}' /etc/resolv.conf):11434

# Windows host for audio HTTP bridge (WSL2). Vuoto = IP del nameserver in
# /etc/resolv.conf (NAT). In networking mirrored impostare 127.0.0.1.
# In Docker non lasciare vuoto: vedi il blocco «Se usi Docker» sotto.
# Checklist firewall 8765, tre wake e timeout 45s: docs/audio_host.md
WINDOWS_HOST=
WINDOWS_AUDIO_PORT=8765
# Timeout HTTP WSL → host (connect resta 5s nel client). Listen copre wake +
# dettatura; speak copre sintesi e playback. Default 300 / 120 secondi.
# AUDIO_LISTEN_TIMEOUT_SEC=300
# AUDIO_SPEAK_TIMEOUT_SEC=120

# Data workspace (file utente: note, PDF). Default: Desktop Windows Ollama_test.
# Sul host WSL questi path restano quelli attuali (Desktop montato in /mnt/c).
# WORKSPACE_ROOT=/mnt/c/Users/User/Desktop/Ollama_test
# Stato locale (RAG, telemetria, token Gmail) nel repo. Default: <repo>/runtime
# INDEX_ROOT=

# --- Se usi Docker (docs/docker.md) ---
# Compose legge questo .env (chiavi API) ma *dentro* il container sovrascrive
# i path Linux. Non copiare WORKSPACE_ROOT=/workspace nel .env usato dal venv
# WSL: sul host restano /mnt/c/... e <repo>/runtime. Il default di config.py
# (/mnt/c/Users/User/Desktop/Ollama_test) in un container Linux non esiste.
#
# HOST_WORKSPACE è solo per il volume Compose (host → /workspace). Cambia User
# e cartella. Non è letto da config.py.
# HOST_WORKSPACE=/mnt/c/Users/User/Desktop/Ollama_test
#
# Override Compose nel container (non servirli a mano nel .env WSL):
#   WORKSPACE_ROOT=/workspace
#   INDEX_ROOT=/index
# /index è il mount di ./runtime (indice RAG, token Gmail se già presente).
#
# Hands-free: AUDIO_DRIVER=http solo nel .env locale, mai nel Compose committato.
# In Docker la discovery da /etc/resolv.conf punta al DNS interno 127.0.0.11,
# non all'IP Windows: serve host.docker.internal (extra_hosts host-gateway).
# WINDOWS_HOST=host.docker.internal

# Cloud LLM: chiave obbligatoria con `--llm gemini`; modello opzionale (default gemini-3.5-flash).
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash
# ANTHROPIC_API_KEY=

# Ricerca web (`lavora-e-guida --agent web`): chiave `tvly-…` da app.tavily.com.
# Obbligatoria solo per quell'agente; gli altri partono anche senza.
TAVILY_API_KEY=

# Gmail OAuth (consenso a tavolino, non nel loop vocale).
# Checklist Console, client Desktop, WSL2 e re-auth incrementale: docs/gmail_oauth.md
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_USER=account@gmail.com
# GMAIL_TOKEN_FILE=   # default: INDEX_ROOT/gmail_token.json
