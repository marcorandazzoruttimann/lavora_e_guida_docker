# Orchestrator framework: crewai | autogen (lazy-loaded at runtime)
ORCHESTRATOR_FRAMEWORK=crewai

# Audio I/O: mock (CLI keyboard/print) | http (Windows host bridge)
AUDIO_DRIVER=mock

# Local Ollama model (one at a time; hardware-friendly defaults)
OLLAMA_MODEL=qwen2.5:3b
# OLLAMA_BASE_URL=http://127.0.0.1:11434

# Windows host for audio HTTP bridge (WSL2). Leave empty to discover
# from /etc/resolv.conf nameserver; set to override.
WINDOWS_HOST=
WINDOWS_AUDIO_PORT=8765

# Cloud LLM keys (Phase 4; optional)
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
